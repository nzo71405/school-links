            padding: 25px;
            color: var(--text-muted);
            font-size: 0.9rem;
            border-top: 1px solid var(--border-color);
            background: #ffffff;
        }

        @media (max-width: 768px) {
            .header-wrapper { flex-direction: column; align-items: flex-start; }
