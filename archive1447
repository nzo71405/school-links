        .card-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px dashed var(--border-color);
            padding-top: 15px;
        }

        .sub-links-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 100%;
            margin-top: 10px;
        }

        .btn-sub-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            background: var(--bg-page);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: var(--primary-navy);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .btn-sub-link:hover {
            background: var(--primary-navy);
            color: white;
            border-color: var(--primary-navy);
        }

        .btn-view {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 18px;
            border-radius: 10px;
            background: var(--primary-navy);
            color: white;
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .btn-view:hover {
            background: var(--accent-green);
