            height: 90px;
            background: rgba(255, 255, 255, 0.95);
            border: 2px dashed #3b82f6;
            border-radius: 14px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 4px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            cursor: pointer;
            position: relative;
            transition: all 0.2s ease;
            text-align: center;
        }

        .ministerial-logo:hover {
            background: #ffffff;
            border-color: var(--accent-gold);
        }

        .ministerial-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: none;
            border-radius: 10px;
        }

        .logo-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            color: #1e293b;
        }

        .logo-placeholder i {
            font-size: 1.3rem;
            color: #2563eb;
        }

        .logo-placeholder span {
            font-size: 0.65rem;
            font-weight: 700;
            line-height: 1.2;
        }

        .header-title h1 {
            font-size: 1.9rem;
            font-weight: 800;
            margin-bottom: 6px;
            letter-spacing: -0.5px;
        }

        .header-title p {
            color: #94a3b8;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .header-meta {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .meta-item {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(8px);
            padding: 10px 18px;
            border-radius: var(--radius-md);
            border: 1px solid rgba(255, 255, 255, 0.12);
            font-size: 0.9rem;
            color: #f1f5f9;
        }

        .container {
            max-width: 1200px;
            margin: 40px auto 0;
            padding: 0 20px;
        }

        .section-header {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--primary-navy);
            margin: 30px 0 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-right: 5px solid var(--accent-gold);
            padding-right: 14px;
        }

        .grid-cards {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 22px;
        }

        .card {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            padding: 24px;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
            border-color: #cbd5e1;
        }

        .card-header-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            margin-bottom: 16px;
        }

        .icon-green { background: #ecfdf5; color: var(--accent-green); }
        .icon-blue { background: #eff6ff; color: #2563eb; }
        .icon-gold { background: #fffbeb; color: var(--accent-gold); }
        .icon-purple { background: #faf5ff; color: #9333ea; }

        .card h3 {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--primary-navy);
            margin-bottom: 8px;
        }

        .card p {
            font-size: 0.9rem;
            color: var(--text-muted);
            line-height: 1.5;
            margin-bottom: 20px;
